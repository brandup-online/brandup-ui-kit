root = true

[*]
indent_style = tab
indent_size = 4
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# The line ending is deliberately not set here: git decides it via .gitattributes
# (`* text=auto`) — LF in the repository, and whatever is native to the system in the working tree.
# A hard-coded `end_of_line = crlf` would conflict with that on Linux and in CI.

# In markdown two spaces at the end of a line are a line break, they must not be trimmed.
[*.md]
trim_trailing_whitespace = false
