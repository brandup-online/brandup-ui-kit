{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ESNext",
		"strict": true,
		"lib": ["ESNext", "DOM"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		// Как и у остальных пакетов: этот конфиг только проверяет типы, собирает фронтенд webpack
		// (бэкенд — свой tsconfig.backend.json). Флагом это и так просил `npm run build`, но без
		// него в конфиге `tsc -p` рядом с исходниками раскладывал .js — а на них потом валился
		// `oxlint`: там браузерных глобалов нет, и получалось «document is not defined».
		"noEmit": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"types": ["jest"]
	},
	"exclude": ["node_modules", "wwwroot", "server", "src/backend", ".idea", ".vscode"],
	"compileOnSave": false
}
