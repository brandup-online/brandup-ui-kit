{
	"publishConfig": {
		"access": "public"
	},
	"name": "@brandup/ui-kit",
	"description": "Base UI kit: reset, typography, form field styles, PopupManager and app middleware.",
	"keywords": [
		"brandup",
		"javascript",
		"typescript",
		"ui"
	],
	"author": {
		"name": "Dmitry Kovyazin",
		"email": "it@brandup.online"
	},
	"homepage": "https://github.com/brandup-online/brandup-ui-kit/npm/brandup-ui-kit",
	"repository": {
		"type": "git",
		"url": "https://github.com/brandup-online/brandup-ui-kit.git"
	},
	"bugs": {
		"url": "https://github.com/brandup-online/brandup-ui-kit/issues",
		"email": "it@brandup.online"
	},
	"type": "module",
	"license": "Apache-2.0",
	"version": "1.0.0",
	"main": "source/index.ts",
	"types": "source/index.ts",
	"exports": {
		".": "./source/index.ts",
		"./names": "./source/names.ts",
		"./i18n": "./source/i18n.ts",
		"./locale/*": "./locale/*",
		"./env": "./source/env.ts",
		"./position": "./source/position.ts",
		"./text": "./source/utils/text.ts",
		"./vars.less": "./vars.less",
		"./source/*.less": "./source/*.less",
		"./build/*": "./build/*",
		"./svg/*": "./svg/*",
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@brandup/ui-app": "^2.0.14"
	},
	"devDependencies": {
		"less": "^4.9.1",
		"typescript": "^7.0.2"
	},
	"files": [
		"source",
		"locale",
		"build",
		"svg",
		"vars.less",
		"README.md",
		"TOKENS.md"
	],
	"scripts": {
		"build": "tsc",
		"watch": "tsc -w",
		"docs:tokens": "node build/build-tokens-doc.cjs"
	}
}
