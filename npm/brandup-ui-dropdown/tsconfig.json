{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ESNext",
		"strict": true,
		"lib": ["DOM", "ESNext"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noEmit": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		// TypeScript 6 no longer auto-discovers @types from parent node_modules,
		// so the jest globals used in test/ have to be requested explicitly.
		"types": ["jest"]
	},
	"include": ["source", "test"],
	"exclude": ["node_modules", "dist", ".vs", ".vscode"],
	"compileOnSave": false
}
