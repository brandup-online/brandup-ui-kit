{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Example: build & start",
			"type": "node-terminal",
			"request": "launch",
			"cwd": "${workspaceFolder}/npm/brandup-ui-example",
			"command": "npm run serve"
		},
		{
			"name": "Example: start (skip build)",
			"type": "node-terminal",
			"request": "launch",
			"cwd": "${workspaceFolder}/npm/brandup-ui-example",
			"command": "npm run start"
		},
		{
			"name": "Example: dev-server (live reload)",
			"type": "node-terminal",
			"request": "launch",
			"cwd": "${workspaceFolder}/npm/brandup-ui-example",
			"command": "npm run dev-server"
		},
		{
			// Половина compound'а: браузер открывает dev-server (порт 8080), поэтому сервер
			// просят молчать — иначе на каждый запуск открывалось бы две вкладки.
			"name": "Example: API (no browser)",
			"type": "node-terminal",
			"request": "launch",
			"cwd": "${workspaceFolder}/npm/brandup-ui-example",
			"command": "npm run start -- --no-open"
		}
	],
	"compounds": [
		{
			"name": "Example: watch + live reload",
			"configurations": ["Example: API (no browser)", "Example: dev-server (live reload)"],
			"stopAll": true
		}
	]
}
